# ---------------------------------------------------------------------------
# Engineering Memory Graph — example environment configuration.
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored; `.env.example` (this file) is committed.
# ---------------------------------------------------------------------------

# --- Neo4j ----------------------------------------------------------------
# In docker-compose the API talks to the `neo4j` service on the compose
# network. For host-side tooling (e.g. running tests outside the container),
# use bolt://localhost:7687 instead.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# --- Azure OpenAI (LLM + embeddings) --------------------------------------
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Deployment names (NOT model names) as configured in Azure OpenAI Studio.
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large

# --- Azure AI Search (production vector store) ----------------------------
# Leave blank in local dev; Qdrant is used instead (see QDRANT_URL).
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

# --- Qdrant (local dev vector store) --------------------------------------
QDRANT_URL=http://qdrant:6333

# --- Source system integrations -------------------------------------------
# GitHub App or personal access token with repo:read + webhooks.
GITHUB_TOKEN=

# Atlassian (Jira + Confluence) API tokens. Jira and Confluence are separate
# tokens if scoped narrowly; can be the same token if the account has access
# to both products.
JIRA_TOKEN=
JIRA_EMAIL=
JIRA_URL=https://<your-org>.atlassian.net

CONFLUENCE_TOKEN=
CONFLUENCE_URL=https://<your-org>.atlassian.net/wiki

# --- Query API --------------------------------------------------------------
# Internal API key used by the X-API-Key header on all Query_API requests.
API_KEY=dev-api-key

# --- MCP server registry --------------------------------------------------
# Path (inside the running container) to the MCP server YAML config.
# The API container bind-mounts ./src at /app/src, so this path resolves to
# ./src/config/mcp_servers.yaml on the host.
MCP_SERVERS_CONFIG_PATH=/app/src/config/mcp_servers.yaml
